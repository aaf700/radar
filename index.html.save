<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Overhead Radar Display</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body, html { height: 100%; width: 100vw; background: #070a12; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow: hidden; }

    #app { display: flex; height: 100vh; width: 100vw; }

    #map-container { flex: 70; position: relative; height: 100%; }
    #map { height: 100%; width: 100%; background: #070a12; }

    #dashboard {
      flex: 30;
      background: rgba(13, 19, 33, 0.98);
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      padding: 24px;
      justify-content: space-between;
    }

    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 12px;
    }
    .header-title { font-weight: 800; font-size: 15px; letter-spacing: 1.5px; color: #38bdf8; text-transform: uppercase; }
    .status-badge { font-size: 11px; padding: 4px 8px; border-radius: 20px; background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #34d399; box-shadow: 0 0 8px #34d399; }

    .photo-container {
      width: 100%;
      height: 240px;
      border-radius: 12px;
      background: #020617;
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
      position: relative;
      margin: 16px 0;
    }
    .photo-container img { width: 100%; height: 100%; object-fit: cover; }
    .photo-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; color: #64748b; font-size: 13px; }

    .hero-info { margin-bottom: 16px; }
    .callsign { font-size: 36px; font-weight: 900; letter-spacing: 1px; color: #f8fafc; }
    .airline { font-size: 13px; color: #94a3b8; margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px; }

    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .metric-card { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05); padding: 14px; border-radius: 8px; }
    .metric-label { font-size: 10px; text-transform: uppercase; color: #64748b; letter-spacing: 1px; margin-bottom: 4px; }
    .metric-value { font-size: 20px; font-weight: 700; color: #f1f5f9; }

    .footer-stats {
      font-size: 12px;
      color: #64748b;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 12px;
    }

    .plane-icon-wrapper { transition: transform 0.8s linear; }
    .active-plane-icon { filter: drop-shadow(0 0 10px #38bdf8); }
  </style>
</head>
<body>

<div id="app">
  <div id="map-container">
    <div id="map"></div>
  </div>

  <div id="dashboard">
    <div>
      <div class="header-bar">
        <div class="header-title">Live Tracking</div>
        <div class="status-badge"><div class="status-dot"></div> AUTOPILOT</div>
      </div>

      <div class="photo-container">
        <img id="plane-photo" src="" style="display: none;" />
        <div id="photo-placeholder" class="photo-placeholder">Fetching Aircraft Image...</div>
      </div>

      <div class="hero-info">
        <div class="callsign" id="val-callsign">---</div>
        <div class="airline" id="val-icao">ICAO: ----</div>
      </div>

      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-label">Altitude</div>
          <div class="metric-value" id="val-altitude">-- ft</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Ground Speed</div>
          <div class="metric-value" id="val-speed">-- kts</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Distance Away</div>
          <div class="metric-value" id="val-distance">-- km</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Heading</div>
          <div class="metric-value" id="val-heading">--°</div>
        </div>
      </div>
    </div>

    <div class="footer-stats">
      <span>Overhead: <strong id="val-total" style="color: #38bdf8;">0</strong></span>
      <span id="val-timer">Next Focus in 8s</span>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const MY_LAT = 25.2048;
  const MY_LON = 55.2708;
  const RADIUS_DEG = 0.35;

  const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([MY_LAT, MY_LON], 10);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);

  L.circleMarker([MY_LAT, MY_LON], { color: '#ef4444', radius: 7, fillOpacity: 1 }).addTo(map);

  let aircraftList = [];
  let currentIndex = 0;
  let markers = {};
  let secondsRemaining = 8;

  function calculateDistance(lat, lon) {
    const R = 6371;
    const dLat = (lat - MY_LAT) * Math.PI / 180;
    const dLon = (lon - MY_LON) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(MY_LAT * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return (R * c).toFixed(1);
  }

  function createPlaneIcon(heading, isSelected) {
    const color = isSelected ? '#38bdf8' : '#94a3b8';
    const scale = isSelected ? '1.4' : '1.0';
    return L.divIcon({
      className: `plane-icon-wrapper ${isSelected ? 'active-plane-icon' : ''}`,
      html: `<div style="transform: rotate(${heading}deg) scale(${scale}); transition: transform 0.5s ease;">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="${color}">
                <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
              </svg>
             </div>`,
      iconSize: [30, 30],
      iconAnchor: [15, 15]
    });
  }

  async function updateFlightData() {
    const lamin = MY_LAT - RADIUS_DEG, lamax = MY_LAT + RADIUS_DEG;
    const lomin = MY_LON - RADIUS_DEG, lomax = MY_LON + RADIUS_DEG;
    const url = `https://opensky-network.org/api/states/all?lamin=${lamin}&lamax=${lamax}&lomin=${lomin}&lomax=${lomax}`;

    try {
      const res = await fetch(url);
      const data = await res.json();
      
      if (!data.states || data.states.length === 0) return;

      aircraftList = data.states.map(f => ({
        icao: f[0],
        callsign: (f[1] || 'N/A').trim(),
        lon: f[5],
        lat: f[6],
        altitude: f[7] ? Math.round(f[7] * 3.28084) : 0,
        speed: f[9] ? Math.round(f[9] * 1.94384) : 0,
        heading: f[10] || 0,
        distance: calculateDistance(f[6], f[5])
      })).filter(item => item.lat && item.lon);

      document.getElementById('val-total').innerText = aircraftList.length;

      aircraftList.forEach(plane => {
        if (markers[plane.icao]) {
          markers[plane.icao].setLatLng([plane.lat, plane.lon]);
        } else {
          const marker = L.marker([plane.lat, plane.lon], {
            icon: createPlaneIcon(plane.heading, false)
          }).addTo(map);
          markers[plane.icao] = marker;
        }
      });

    } catch (e) {
      console.log("Network sync...");
    }
  }

  function focusNextAircraft() {
    if (aircraftList.length === 0) return;

    if (currentIndex >= aircraftList.length) currentIndex = 0;
    const plane = aircraftList[currentIndex];

    Object.keys(markers).forEach(icao => {
      const isTarget = (icao === plane.icao);
      const targetPlane = aircraftList.find(a => a.icao === icao);
      if (targetPlane && markers[icao]) {
        markers[icao].setIcon(createPlaneIcon(targetPlane.heading, isTarget));
      }
    });

    map.panTo([plane.lat, plane.lon], { animate: true, duration: 1.2 });

    document.getElementById('val-callsign').innerText = plane.callsign || 'UNKNOWN';
    document.getElementById('val-icao').innerText = `ICAO: ${plane.icao.toUpperCase()}`;
    document.getElementById('val-altitude').innerText = `${plane.altitude.toLocaleString()} ft`;
    document.getElementById('val-speed').innerText = `${plane.speed} kts`;
    document.getElementById('val-distance').innerText = `${plane.distance} km`;
    document.getElementById('val-heading').innerText = `${Math.round(plane.heading)}°`;

    const imgEl = document.getElementById('plane-photo');
    const phEl = document.getElementById('photo-placeholder');
    imgEl.style.display = 'none';
    phEl.style.display = 'flex';
    phEl.innerText = "Loading Aircraft Photo...";

    const photoUrl = `https://hexdb.io/api/v2/aircraft/${plane.icao}/image/thumbnail`;
    const testImg = new Image();
    testImg.src = photoUrl;
    testImg.onload = () => {
      imgEl.src = photoUrl;
      imgEl.style.display = 'block';
      phEl.style.display = 'none';
    };
    testImg.onerror = () => {
      phEl.innerText = "No Photo Available";
    };

    currentIndex++;
  }

  setInterval(() => {
    secondsRemaining--;
    if (secondsRemaining <= 0) {
      focusNextAircraft();
      secondsRemaining = 8;
    }
    document.getElementById('val-timer').innerText = `Next Focus in ${secondsRemaining}s`;
  }, 1000);

  updateFlightData();
  setInterval(updateFlightData, 10000);
</script>
</body>
</html>0
